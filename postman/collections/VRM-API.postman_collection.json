{
  "info": {
    "name": "VRM API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base", "value": "http://localhost:8080/VRM-1.0-SNAPSHOT" },
    { "key": "uid",  "value": "1" },
    { "key": "gid",  "value": "1" }
  ],
  "item": [

    {
      "name": "01 - Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "url": "{{base}}/users",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"thisha\",\n  \"email\": \"thisha@example.com\",\n  \"password\": \"Pass@1234\",\n  \"ph_no\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "url": "{{base}}/users/{{uid}}"
          }
        },
        {
          "name": "Full update user (PUT)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/users/{{uid}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"thisha_updated\",\n  \"email\": \"thisha@example.com\",\n  \"ph_no\": \"9999999999\"\n}"
            }
          }
        },
        {
          "name": "Partial update user (PATCH)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/users/{{uid}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ph_no\": \"8888888888\"\n}"
            }
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/users/{{uid}}/password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPass@5678\"\n}"
            }
          }
        },
        {
          "name": "Change status (ADMIN)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/users/{{uid}}/status",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            }
          }
        },
        {
          "name": "List all users (ADMIN)",
          "request": { "method": "GET", "url": "{{base}}/users" }
        },
        {
          "name": "Search users (ADMIN)",
          "request": { "method": "GET", "url": "{{base}}/users?search=thisha" }
        },
        {
          "name": "Filter users by status (ADMIN)",
          "request": { "method": "GET", "url": "{{base}}/users?status=ACTIVE" }
        },
        {
          "name": "Sort users (ADMIN)",
          "request": { "method": "GET", "url": "{{base}}/users?sort=username&order=asc" }
        },
        {
          "name": "Search + filter + sort (ADMIN)",
          "request": { "method": "GET", "url": "{{base}}/users?search=thisha&status=ACTIVE&sort=created_at&order=desc" }
        }
      ]
    },

    {
