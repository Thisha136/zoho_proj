    {
      "name": "11 - Service Requests",
      "item": [
        {
          "name": "Create service request (USER)",
          "request": {
            "method": "POST",
            "url": "{{base}}/service-requests",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{uid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bike_id\": 1,\n  \"gid\": 1,\n  \"bid\": 1,\n  \"title\": \"Engine noise at startup\",\n  \"issue\": \"Loud knocking sound when engine starts\",\n  \"preferred_delivery_date\": \"2026-10-01\",\n  \"vehicle_handling_option\": \"DROP\"\n}"
            }
          }
        },
        {
          "name": "List own requests (USER)",
          "request": {
            "method": "GET",
            "url": "{{base}}/service-requests",
            "header": [{ "key": "X-User-Id", "value": "{{uid}}" }]
          }
        },
        {
          "name": "Filter by status (USER)",
          "request": {
            "method": "GET",
            "url": "{{base}}/service-requests?status=PENDING",
            "header": [{ "key": "X-User-Id", "value": "{{uid}}" }]
          }
        },
        {
          "name": "Filter by bike (USER)",
          "request": {
            "method": "GET",
            "url": "{{base}}/service-requests?bike_id=1",
            "header": [{ "key": "X-User-Id", "value": "{{uid}}" }]
          }
        },
        {
          "name": "Get request by ID",
          "request": { "method": "GET", "url": "{{base}}/service-requests/1" }
        },
        {
          "name": "Update request (USER PATCH)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/service-requests/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{uid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"preferred_delivery_date\": \"2026-10-05\"\n}"
            }
          }
        },
        {
          "name": "Cancel request (USER)",
          "request": {
            "method": "POST",
            "url": "{{base}}/service-requests/1/cancel",
            "header": [{ "key": "X-User-Id", "value": "{{uid}}" }]
          }
        },
        {
          "name": "Respond to proposed date - ACCEPT (USER)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/service-requests/1/date-response",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{uid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"response\": \"ACCEPTED\"\n}" }
          }
        },
        {
          "name": "Respond to proposed date - REJECT (USER)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/service-requests/1/date-response",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{uid}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"response\": \"REJECTED\"\n}" }
          }
        },
        {
          "name": "List garage requests (GARAGE)",
          "request": {
            "method": "GET",
            "url": "{{base}}/garages/{{gid}}/service-requests",
            "header": [{ "key": "X-Garage-Id", "value": "{{gid}}" }]
          }
        },
        {
          "name": "Filter garage requests by status",
          "request": {
            "method": "GET",
            "url": "{{base}}/garages/{{gid}}/service-requests?status=PENDING",
            "header": [{ "key": "X-Garage-Id", "value": "{{gid}}" }]
          }
        },
        {
          "name": "Filter garage requests by date range",
          "request": {
            "method": "GET",
            "url": "{{base}}/garages/{{gid}}/service-requests?from=2026-09-01&to=2026-09-30",
            "header": [{ "key": "X-Garage-Id", "value": "{{gid}}" }]
          }
        },
        {
          "name": "Record physical review (GARAGE)",
          "request": {
            "method": "PATCH",
            "url": "{{base}}/garages/{{gid}}/service-requests/1/physical-review",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
