          "request": { "method": "GET", "url": "{{base}}/users/{{uid}}/addresses/1" }
        },
        {
          "name": "Full update address (PUT)",
          "request": {
            "method": "PUT",
            "url": "{{base}}/users/{{uid}}/addresses/1",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_type\": \"WORK\",\n  \"address_line\": \"55 Brigade Road\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560025\",\n  \"is_default\": false\n}"
