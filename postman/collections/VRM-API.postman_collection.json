              "mode": "raw",
              "raw": "{\n  \"address_type\": \"HOME\",\n  \"address_line\": \"12 MG Road\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\",\n  \"is_default\": true\n}"
